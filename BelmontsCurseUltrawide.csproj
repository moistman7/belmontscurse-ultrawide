<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BelmontsCurseUltrawide</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Game folder: -p:GameDir=..., else the BELMONTS_CURSE_DIR environment variable, else the default Steam path. -->
    <GameDir Condition="'$(GameDir)' == ''">$(BELMONTS_CURSE_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Castlevania Belmont's Curse</GameDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(InteropDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Localization" HintPath="$(InteropDir)\Unity.Localization.dll" Private="false" />
    <Reference Include="FMODUnity" HintPath="$(InteropDir)\FMODUnity.dll" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(InteropDir)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(InteropDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(InteropDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(InteropDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(InteropDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(InteropDir)\UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(InteropDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(InteropDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(InteropDir)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="Cinemachine" HintPath="$(InteropDir)\Cinemachine.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="MotherBase.RoomDesigner" HintPath="$(InteropDir)\MotherBase.RoomDesigner.dll" Private="false" />
    <Reference Include="MotherBase.EntityFramework" HintPath="$(InteropDir)\MotherBase.EntityFramework.dll" Private="false" />
    <Reference Include="MotherBase.ToolKit" HintPath="$(InteropDir)\MotherBase.ToolKit.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll')" Text="BepInEx 6 (IL2CPP) not found at '$(BepInExCoreDir)'. Install it into the game folder, then build with -p:GameDir=&lt;game folder&gt; or set BELMONTS_CURSE_DIR." />
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')" Text="No interop assemblies in '$(InteropDir)'. Launch the game once with BepInEx installed so it generates them." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins') And '$(SkipDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
  </Target>

</Project>
